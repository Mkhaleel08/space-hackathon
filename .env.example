# Copy to .env.local and fill in. .env.local is gitignored. Never commit real keys.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes and the seed script. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM. Pick one provider at the 9:00 decision lock and delete the other line.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Operator dashboard. Shared PIN for deleting notes and adding parts. Leave
# empty to switch those actions off.
OPERATOR_PIN=
